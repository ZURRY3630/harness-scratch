# --- 虚拟环境 ---
.venv/
venv/

# --- 环境变量（含密钥，禁止入库） ---
.env
.env.local

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.pytest_tmp/
.pytest_tmp*/

# --- 运行数据（SQLite；路径相对进程工作目录，故可能出现在任意层级） ---
**/data/*.db
**/data/*.db-shm
**/data/*.db-wal
**/*.trace.jsonl

# --- 技能安装目录（运行时安装，不入库；示例见 examples/skills/）---
data/skills/

# --- 本地演示/临时工程 ---
.demo_project/

# --- 前端 ---
frontend/node_modules/
frontend/dist/

# --- 编辑器 ---
.vscode/
.idea/
*.swp
